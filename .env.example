# Provider-agnostic LLM settings
# OpenAI-compatible providers use protocol=openai_chat.
# Ollama uses protocol=ollama and does not require an API key.

AI_PROVIDER=openai_compatible
AI_PROTOCOL=openai_chat
AI_API_KEY=YOUR_API_KEY
AI_API_KEY_ENV=AI_API_KEY
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=YOUR_MODEL

# Optional custom endpoint/auth settings
# AI_ENDPOINT=chat/completions
# AI_AUTH_TYPE=bearer
# AI_AUTH_HEADER=Authorization
# AI_AUTH_PREFIX=Bearer

# Examples:
# OpenRouter:
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=YOUR_OPENROUTER_MODEL
#
# Ollama:
# AI_PROVIDER=ollama
# AI_PROTOCOL=ollama
# AI_API_KEY=
# AI_BASE_URL=http://127.0.0.1:11434
# AI_MODEL=llama3.2
